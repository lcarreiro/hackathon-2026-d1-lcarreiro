{
  "dominio": "Duplicatas escriturais",
  "padrao": "SEM_REGRA",
  "variaveis": { "data_referencia": "2026-10-23" },
  "regras": [
    { "codigo": "R01", "categoria": "Fora da carteira",
      "se": { "campo": "status", "op": "em", "valor": ["CANCELADA", "LIQUIDADA"] } },

    { "codigo": "R02", "categoria": "Risco de operação inexistente",
      "se": { "qualquer": [
        { "campo": "logistica.status_entrega", "op": "=", "valor": "DEVOLVIDA" },
        { "campo": "manifestacao.tipo", "op": "=", "valor": "RCOP" } ] } },

    { "codigo": "R03", "categoria": "Recusada pelo sacado",
      "se": { "campo": "manifestacao.tipo", "op": "em", "valor": ["RCAV", "RCQQ", "RCVN", "RCVL"] } },

    { "codigo": "R04", "categoria": "Candidata a recusa por avaria",
      "se": { "todas": [
        { "campo": "logistica.status_entrega", "op": "=", "valor": "AVARIADA" },
        { "campo": "manifestacao.tipo", "op": "vazio" } ] } },

    { "codigo": "R05", "categoria": "Vencida em aberto",
      "se": { "todas": [
        { "campo": "data_vencimento", "op": "<", "tipo": "data", "valor": "$data_referencia" },
        { "campo": "financeiro.valor_pago", "op": "<", "tipo": "numero", "campo_ref": "financeiro.valor" } ] } },

    { "codigo": "R06", "categoria": "Garantia relevante",
      "se": { "todas": [
        { "campo": "financeiro.tipo_negociacao", "op": "em", "valor": ["CSFD", "PENR"] },
        { "campo": "financeiro.valor", "op": ">=", "valor": 100000 } ] } },

    { "codigo": "R07", "categoria": "Alto valor",
      "se": { "qualquer": [
        { "campo": "financeiro.valor", "op": ">=", "valor": 500000 },
        { "todas": [
          { "campo": "sacado.segmento", "op": "=", "valor": "AGRO" },
          { "campo": "financeiro.valor", "op": ">=", "valor": 200000 } ] } ] } },

    { "codigo": "R08", "categoria": "CFOP interno em operação interestadual",
      "se": { "todas": [
        { "campo": "logistica.uf_origem", "op": "!=", "tipo": "texto", "campo_ref": "logistica.uf_destino" },
        { "campo": "fiscal.cfop", "op": "comeca_com", "valor": "5" } ] } },

    { "codigo": "R09", "categoria": "Frete aéreo pesado",
      "se": { "todas": [
        { "campo": "logistica.modal", "op": "=", "valor": "AEREO" },
        { "campo": "logistica.peso_kg", "op": ">", "valor": 500 } ] } },

    { "codigo": "R10", "categoria": "Entregue sem recebimento no ERP",
      "se": { "todas": [
        { "campo": "logistica.status_entrega", "op": "=", "valor": "ENTREGUE" },
        { "campo": "logistica.migo", "op": "=", "valor": false } ] } },

    { "codigo": "R11", "categoria": "Apta para antecipação",
      "se": { "todas": [
        { "campo": "manifestacao.tipo", "op": "=", "valor": "ACTO" },
        { "campo": "logistica.migo", "op": "=", "valor": true } ] } },

    { "codigo": "R12", "categoria": "Pequeno valor via Pix",
      "se": { "todas": [
        { "campo": "pagamento.instrumento", "op": "=", "valor": "PPIX" },
        { "campo": "sacador.porte", "op": "em", "valor": ["ME", "EPP"] },
        { "campo": "financeiro.valor", "op": "<=", "valor": 5000 } ] } }
  ]
}
